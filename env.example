# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Secret (change this in production!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Default Admin User
ADMIN_EMAIL=admin@uptake.local
ADMIN_PASSWORD=admin123

# CORS - Frontend URL (comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration (Prisma)
# SQLite (default - local file):
DATABASE_URL="file:./data/uptake.db"
# PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/uptake?schema=public"
# MySQL:
# DATABASE_URL="mysql://username:password@localhost:3306/uptake"